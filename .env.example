# --- core ---
DATABASE_URL=postgresql://voice:voice@localhost:5432/voice
VAPI_SECRET=generate-a-long-random-string      # python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=change-me                        # dashboard login: admin / this password
JOBS_TOKEN=another-long-random-string           # protects POST /jobs/reminders

# --- clinic profile ---
CLINIC_NAME=BrightSmile Dental
CLINIC_TIMEZONE=America/New_York
CLINIC_PHONE=+15555550100                       # human front desk, used for call transfers
CLINIC_ADDRESS=120 Main Street, Suite 4, Springfield
CLINIC_CHAIRS=2
STAFF_ALERT_PHONE=                              # gets an SMS for emergencies and new leads

# --- Twilio SMS (leave empty for dry-run: messages are logged) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google Calendar (leave empty to disable sync) ---
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json   # path, or the JSON itself on one line

# --- only for scripts/vapi_setup.py ---
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_CREDENTIAL_ID=
VAPI_PUBLIC_KEY=
LLM_MODEL=gpt-4.1                               # Vapi assistant model; also used by the browser demo line

# Browser demo line (/call). Without a key, a built-in dialogue engine drives the same tools.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1          # any OpenAI-compatible endpoint

# Public demo: open dashboard, sample clinic reset daily, SMS never sent
DEMO_MODE=false
PUBLIC_URL=
CRON_SECRET=
